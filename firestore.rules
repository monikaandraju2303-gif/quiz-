rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && request.resource.data.role in ['teacher', 'student'];
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
    }

    // Classroom management
    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(classId) && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(classId) && (
        resource.data.teacherId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds']) && request.auth.uid in request.resource.data.studentIds)
      );
      allow delete: if isSignedIn() && isValidId(classId) && resource.data.teacherId == request.auth.uid;
    }

    // Study materials
    match /materials/{materialId} {
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.classId != ''
      );
      allow create: if isSignedIn() && isValidId(materialId) && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(materialId) && resource.data.ownerId == request.auth.uid;
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.status == 'published'
      );
      allow create: if isSignedIn() && isValidId(quizId) && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSignedIn() && isValidId(quizId) && resource.data.teacherId == request.auth.uid;
    }

    // Attempts
    match /attempts/{attemptId} {
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(attemptId) && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(attemptId) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(attemptId) && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get, list, update, delete: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(notificationId);
    }
  }
}
